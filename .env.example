## MODEL DEPLOYMENT (gestor de modelos)
# Base desde la que la Pi descarga los .tflite (servidor de artefactos de iot-server-fl).
# Debe ser la IP del host alcanzable DESDE LA PI, no localhost.
ARTIFACT_BASE_URL=http://192.168.1.41:8000
# Reenvío de despliegues pendientes sin ACK (segundos)
DEPLOY_RETRY_SEC=60
